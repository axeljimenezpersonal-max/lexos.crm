{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListarSoloSuCarpeta",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::BUCKET",
      "Condition": { "StringLike": { "s3:prefix": ["produccion/*", "produccion"] } }
    },
    {
      "Sid": "SubirYLeerSinBorrar",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:AbortMultipartUpload"],
      "Resource": "arn:aws:s3:::BUCKET/produccion/*"
    }
  ]
}
